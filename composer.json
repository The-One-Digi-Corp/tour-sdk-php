{
    "name": "theonedigi/tour-sdk-php",
    "description": "PHP SDK for the Travelo Partner API (tour catalog, booking, payment confirmation).",
    "type": "library",
    "license": "proprietary",
    "version": "0.2.0",
    "require": {
        "php": "^8.1",
        "guzzlehttp/guzzle": "^7.2",
        "ext-json": "*",
        "illuminate/http": "^10.0|^11.0|^12.0|^13.0",
        "illuminate/support": "^10.0|^11.0|^12.0|^13.0"
    },
    "require-dev": {
        "orchestra/testbench": "^8.0|^9.0|^10.0",
        "phpunit/phpunit": "^10.0|^11.0"
    },
    "autoload": {
        "psr-4": {
            "TheOneDigi\\TourSdk\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "TheOneDigi\\TourSdk\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "generate:contract": "php tools/generate-contract-dtos.php",
        "check:contract": "php tools/generate-contract-dtos.php --check",
        "test": "phpunit"
    },
    "extra": {
        "laravel": {
            "providers": [
                "TheOneDigi\\TourSdk\\Laravel\\TourSdkServiceProvider"
            ],
            "aliases": {
                "Travelo": "TheOneDigi\\TourSdk\\Laravel\\Facades\\Travelo"
            }
        }
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable"
}
