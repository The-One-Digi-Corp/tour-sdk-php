{
    "name": "theonedigi/tour-sdk-php",
    "description": "PHP SDK for the Travelo Partner API (tour catalog, booking, payment confirmation).",
    "type": "library",
    "license": "proprietary",
    "version": "0.1.0",
    "require": {
        "php": "^8.1",
        "guzzlehttp/guzzle": "^7.2",
        "ext-json": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.0"
    },
    "autoload": {
        "psr-4": {
            "TheOneDigi\\TourSdk\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "TheOneDigi\\TourSdk\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit"
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable"
}
